---
layout: null
---
{%- comment -%}
// @formatter:off
{%- endcomment -%}
[
  {%- assign pages = site.pages | sort: "order" -%}
  {%- for page in pages -%}
    {%- if page.url == const.search.url -%}
      {%- continue -%}
    {%- endif %}
    {%- if page.sitemap.exclude == true or page.name == "feed.xml" or page.name == "/news/feed.xml" or page.name == "data.json" or page.name == "sitemap.xml" -%}
      {%- continue -%}
    {%- endif %}
    {%- if page.pagination_info and page.pagination_info.curr_page > 1 -%}
      {%- continue -%}
    {%- endif %}
    {%- if page.is_taglist or page.is_categorylist -%}
      {%- continue -%}
    {%- endif -%}
    {%- assign content_blank_tmp = page.content | replace_post | strip_newlines -%}
    {%- assign sections_size = page.sections | size -%}
    {%- if content_blank_tmp == "" and sections_size == 0 -%}
    {%- assign content_site = "" -%}
    {%- else -%}
    {%- capture content_site -%}
      {% include content.html paths="absolute" page=page %}
    {%- endcapture -%}
    {%- endif %}
  {
    "type": "site",
    "title_site": {{ page.title | jsonify }},
    "name": {{ page.name | jsonify }},
    "url": {{ page.url | relative_url | jsonify }},
    "dir": {{ page.dir | relative_url | jsonify }},
    "content_site": {{ content_site | strip_html | strip | jsonify }},
    "content_parsed": {{ content_site | pre_markdown | markdownify | replace_post | jsonify }},
    "external_link": {{ page.external_link | jsonify }},
    "data": {{ page | jsonify }}
  },
  {%- endfor -%}

  {%- assign pages = site.pages | where: "is_categorylist", true -%}
  {%- for page in pages -%}
  {%- if page.sitemap.exclude == true -%}
    {%- continue -%}
  {%- endif %}
  {
    "type": "categorylist",
    "title_categorylist": {{ page.title | jsonify }},
    "url": {{ page.url | relative_url | jsonify }},
    "dir": {{ page.dir | relative_url | jsonify }},
    "content_categorylist": "",
    "content_parsed": ""
  },
  {%- endfor -%}

  {%- assign pages = site.pages | where: "is_taglist", true -%}
  {%- for page in pages -%}
  {%- if page.sitemap.exclude == true -%}
    {%- continue -%}
  {%- endif %}
  {
    "type": "taglist",
    "title_taglist": {{ page.title | jsonify }},
    "url": {{ page.url | relative_url | jsonify }},
    "dir": {{ page.dir | relative_url | jsonify }},
    "content_taglist": "",
    "content_parsed": ""
  },
  {%- endfor -%}

  {%- assign posts = site.posts | sort: "date" -%}
  {%- for post in posts -%}
  {%- if post.published == false -%}
    {%- continue -%}
  {%- endif %}
  {
    "type": "post",
    "title_post": {{ post.title | jsonify }},
    "name": {{ post.name | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date_to_xmlschema  | jsonify }},
    "date_formatted": {{ post.date | date: "%B %-d, %Y" | jsonify }},
    "content_post": {{ post.content | strip_html | strip | jsonify }},
    "content_parsed": {{ post.content | pre_markdown | markdownify | replace_post | jsonify }},
    "data": {{ post | jsonify }}
  }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor %}
]